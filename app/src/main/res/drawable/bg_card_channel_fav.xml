<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#36301A" />
            <corners android:radius="8dp" />
            <stroke android:width="3dp" android:color="@color/zen_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#242013" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#B89414" />
        </shape>
    </item>
</selector>
