<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/zen_surface_focused" />
            <corners android:radius="8dp" />
            <stroke android:width="2.5dp" android:color="@color/zen_yellow" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/zen_surface_card" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/zen_border_unfocused" />
        </shape>
    </item>
</selector>
