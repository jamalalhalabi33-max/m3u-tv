<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="600dp"
    android:layout_height="480dp"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- TITLE & CLOSE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Folder"
            android:src="@drawable/ic_folder" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Select M3U File"
            android:textColor="@color/zen_yellow"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_picker_cancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/zen_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- CURRENT PATH -->
    <TextView
        android:id="@+id/tv_current_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="start"
        android:maxLines="1"
        android:textColor="@color/zen_text_secondary"
        android:textSize="12sp" />

    <!-- SHORTCUT PILLS + UP BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_folder_up"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="Up"
            android:textAllCaps="false"
            android:textColor="@color/zen_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_quick_downloads"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Downloads"
            android:textAllCaps="false"
            android:textColor="@color/zen_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_quick_storage"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Internal Storage"
            android:textAllCaps="false"
            android:textColor="@color/zen_text_primary"
            android:textSize="12sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@color/zen_border_unfocused" />

    <!-- EMPTY DIRECTORY MESSAGE -->
    <TextView
        android:id="@+id/tv_empty_folder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="No M3U files or subdirectories found."
        android:textColor="@color/zen_text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- RECYCLER OF FILES AND FOLDERS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_file_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:descendantFocusability="afterDescendants" />

</LinearLayout>
