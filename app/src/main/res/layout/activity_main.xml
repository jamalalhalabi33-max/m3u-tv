<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_leanback_cinema"
    android:orientation="horizontal">

    <!-- LEFT: VIVID ORANGE TV SIDE NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/nav_rail"
        android:layout_width="210dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_nav_rail"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- BRANDING HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_play"
                android:tint="#101010" />

            <TextView
                android:id="@+id/tv_brand_zen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/unbounded"
                android:text="Zen"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/tv_brand_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/unbounded"
                android:text="TV"
                android:textColor="#101010"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- NAVIGATION TABS (LEANBACK TV STYLE PILLS) -->
        <LinearLayout
            android:id="@+id/nav_tab_playlists"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:nextFocusRight="@+id/content_flipper"
            android:nextFocusDown="@+id/nav_tab_favorites"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_playlists"
                android:src="@drawable/ic_nav_playlists" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="PLAYLISTS"
                android:textColor="@color/zen_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tab_favorites"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/nav_tab_playlists"
            android:nextFocusRight="@+id/content_flipper"
            android:nextFocusDown="@+id/nav_tab_settings"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_favorites"
                android:src="@drawable/ic_nav_favorites" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="FAVORITES"
                android:textColor="@color/zen_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_tab_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:nextFocusUp="@+id/nav_tab_favorites"
            android:nextFocusRight="@+id/content_flipper"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_nav_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="SETTINGS"
                android:textColor="@color/zen_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- RIGHT: LEANBACK CONTENT DECK -->
    <ViewFlipper
        android:id="@+id/content_flipper"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- 0: PLAYLISTS VIEW -->
        <LinearLayout
            android:id="@+id/panel_playlists"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- LEANBACK TITLE & ACTION BAR -->
            <LinearLayout
                android:id="@+id/playlist_top_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- BACK / BREADCRUMB BUTTON -->
                <LinearLayout
                    android:id="@+id/btn_playlist_back"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Back"
                        android:src="@drawable/ic_back" />

                    <TextView
                        android:id="@+id/tv_breadcrumb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Playlists"
                        android:textColor="@color/zen_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_playlist_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nav_playlists"
                    android:textColor="@color/zen_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- ICONIC LEANBACK SEARCH ORB -->
                <FrameLayout
                    android:id="@+id/btn_search_toggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_search_orb"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/action_search"
                        android:src="@drawable/ic_search" />
                </FrameLayout>

                <!-- ADD PLAYLIST BUTTON -->
                <Button
                    android:id="@+id/btn_add_playlist"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="18dp"
                    android:text="@string/action_add_playlist"
                    android:textAllCaps="false"
                    android:textColor="#0A0A0A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SEARCH INPUT BAR -->
            <LinearLayout
                android:id="@+id/search_bar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/et_search_query"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:hint="Type channel name or number…"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/zen_text_primary"
                    android:textColorHint="@color/zen_text_muted"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btn_clear_search"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_button_secondary"
                    android:focusable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Clear"
                    android:textAllCaps="false"
                    android:textColor="@color/zen_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- LOADING BAR -->
            <ProgressBar
                android:id="@+id/progress_loading"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- EMPTY MESSAGE -->
            <TextView
                android:id="@+id/tv_playlist_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="@string/empty_playlists"
                android:textColor="@color/zen_text_secondary"
                android:textSize="16sp" />

            <!-- LEANBACK 2-COLUMN CARD GRIDS -->
            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/rv_playlists"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:visibility="gone" />

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/rv_categories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:visibility="gone" />

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/rv_channels"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 1: FAVORITES VIEW -->
        <LinearLayout
            android:id="@+id/panel_favorites"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_favorites_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_favorites"
                android:textColor="@color/zen_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_favorites_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Combined favorites sorted by original channel number"
                android:textColor="@color/zen_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_favorites_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="@string/empty_favorites"
                android:textColor="@color/zen_text_secondary"
                android:textSize="16sp" />

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/rv_favorites"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 2: SETTINGS VIEW -->
        <LinearLayout
            android:id="@+id/panel_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_player_title"
                android:textColor="@color/zen_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_player_desc"
                android:textColor="@color/zen_text_secondary"
                android:textSize="14sp" />

            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/rv_players"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants" />

        </LinearLayout>

    </ViewFlipper>

</LinearLayout>
