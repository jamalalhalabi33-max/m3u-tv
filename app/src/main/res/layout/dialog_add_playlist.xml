<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/action_add_playlist"
        android:textColor="@color/zen_yellow"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Add from an online M3U URL or select a local M3U file"
        android:textColor="@color/zen_text_secondary"
        android:textSize="13sp" />

    <!-- PLAYLIST NAME -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Playlist Name (Optional)"
        android:textColor="@color/zen_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_playlist_name"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_button_secondary"
        android:hint="e.g. My Favorite TV"
        android:imeOptions="actionNext"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/zen_text_primary"
        android:textColorHint="@color/zen_text_muted"
        android:textSize="14sp" />

    <!-- PLAYLIST URL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="M3U Stream URL"
        android:textColor="@color/zen_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_playlist_url"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_button_secondary"
        android:hint="https://example.com/playlist.m3u"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/zen_text_primary"
        android:textColorHint="@color/zen_text_muted"
        android:textSize="14sp" />


    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@color/zen_border_unfocused" />

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_browse_file"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_button_secondary"
            android:drawableStart="@drawable/ic_folder"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="Browse Local File"
            android:textAllCaps="false"
            android:textColor="@color/zen_text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/zen_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_dialog_add_url"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Add from URL"
            android:textAllCaps="false"
            android:textColor="#0B0E13"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
